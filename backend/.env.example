NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_KEY=replace-with-a-different-random-secret
GATEWAY_PORT=4000
MEMBER_SERVICE_PORT=4001
BOOKING_SERVICE_PORT=4002
# URL-encode special characters in the PostgreSQL password. Existing container is reached through host.docker.internal.
MEMBER_DATABASE_URL=postgresql://postgres_user:postgres_password@host.docker.internal:5432/vitality_members
BOOKING_DATABASE_URL=postgresql://postgres_user:postgres_password@host.docker.internal:5432/vitality_bookings
RABBITMQ_USER=vitality
RABBITMQ_PASSWORD=replace-with-a-random-rabbitmq-password
RABBITMQ_DEFAULT_USER=vitality
RABBITMQ_DEFAULT_PASS=replace-with-a-random-rabbitmq-password
RABBITMQ_URL=amqp://vitality:replace-with-a-random-rabbitmq-password@rabbitmq:5672
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
ADMIN_NAME=Vitality Administrator
